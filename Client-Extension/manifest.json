{
  "manifest_version": 3,
  "name": "ABLE - Adaptive Browser-Level Extension",
  "version": "0.1.0",
  "description": "Detects website safety status and provides security warnings for unsafe and unlisted domains",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "config.js",
        "core/storage.js",
        "core/security.js",
        "core/runtime-settings.js",
        "parsers/office-parser.js",
        "api/rate-limiter.js",
        "api/classification.js",
        "api/risk-patterns.js",
        "api/logging.js",
        "api/index.js",
        "content/page-signals.js",
        "content/zoom.js",
        "content/risk-scoring.js",
        "content/file-scanner.js",
        "content/intercept-modal.js",
        "content/text-warning-modal.js",
        "content/site-warning-modal.js",
        "content/repeat-visit-modal.js",
        "content/content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject/inject.js",
        "inject/file-extractor.js",
        "inject/network-interceptor.js",
        "inject/file-tracker.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' http://localhost:8000 https://able-admin.internal:8443"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ABLE - Adaptive Browser-Level Extension"
  }
}

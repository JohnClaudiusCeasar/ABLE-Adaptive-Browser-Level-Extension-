{
  "manifest_version": 3,
  "name": "ABLE - Adaptive Browser-Level Extension",
  "version": "0.0.1",
  "description": "Detects website safety status and provides security warnings for unsafe and unlisted domains",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ABLE - Adaptive Browser-Level Extension"
  }
}
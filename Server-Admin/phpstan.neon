includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - identifier: array.duplicateKey
          path: config/domain_brands.php

    level: 7
